<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>ja</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key><string>Inku</string>
    <key>CFBundleDisplayName</key><string>Inku</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UILaunchScreen</key><dict/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
    </dict>
    <!-- An iPad keeps the Mac's layout, which needs the whole screen; an iPhone takes its own (ios-app step 7). -->
    <key>UIRequiresFullScreen</key><true/>
    <!-- An iPhone stays upright except on the screens that show a work (InkuOrientationDelegate, ios-app step 7). -->
    <key>UISupportedInterfaceOrientations~iphone</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- The app's Documents folder shows in the Files app ("On My iPad › Inku"), for images, DDL and exports (ios-app step 2). -->
    <key>UIFileSharingEnabled</key><true/>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <!-- The share sheet's "Save Image" after an export adds the picture to Photos (ios-app step 2). -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>書き出した作品を写真に保存します。</string>
    <!-- The image tab's "Take photo" draws from a photo taken in the app (ios-app step 6). English: InfoPlist.strings. -->
    <key>NSCameraUsageDescription</key>
    <string>撮った写真から作品を描きます。</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>設定したローカルLLMに接続して作品の記述を生成します。</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key><true/>
    </dict>
    <!-- A drawing or batch keeps going in the background as a continued-processing task, iOS 26+ (ios-app step 5).
         Each run takes a new name under this prefix (IOSBackgroundRuns.swift). -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>app.inku.ios.continued.*</string>
    </array>
</dict>
</plist>
