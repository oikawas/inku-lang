        {"id": "silverpoint", "surface_ja": "銀筆", "surface_en": "silverpoint", "physical_description": {"ja": "揺らぎがほとんどない、細かな線の痕。", "en": "A fine line trace with almost no sway."}, "default": false, "prompt": true, "display": true, "marker": null, "score_value": "silverpoint", "marker_surfaces_ja": null, "marker_surfaces_en": null},
        {"id": "pencil", "surface_ja": "鉛筆", "surface_en": "pencil", "physical_description": {"ja": "連続的に揺らぐ線に、薄い副線と微細な粒が残る。", "en": "A continuously swaying line with faint secondary traces and fine grain."}, "default": false, "prompt": true, "display": true, "marker": null, "score_value": "pencil", "marker_surfaces_ja": null, "marker_surfaces_en": null},
        {"id": "pen", "surface_ja": "ペン", "surface_en": "pen", "physical_description": {"ja": "インクの線の痕。わずかなむらがあり、均一で硬い製図線にもなる。", "en": "An ink line trace with slight variation; it can also be a uniform, hard drafting line."}, "default": true, "prompt": true, "display": true, "marker": null, "score_value": "pen", "marker_surfaces_ja": null, "marker_surfaces_en": null},
        {"id": "chalk", "surface_ja": "チョーク", "surface_en": "chalk", "physical_description": {"ja": "色の粉や蝋の擦れに、かすれと細かな隙間、粒状の欠けが残る。", "en": "Colored powdery or waxy rubbing with scratchiness, fine gaps, and granular breaks."}, "default": false, "prompt": true, "display": true, "marker": null, "score_value": "chalk", "marker_surfaces_ja": null, "marker_surfaces_en": null},
        {"id": "oil_pastel", "surface_ja": "オイルパステル", "surface_en": "oil pastel", "physical_description": {"ja": "蝋と油の不透明な色を厚く擦り重ね、短い運びの跡と紙の目が残る。", "en": "Opaque waxy, oily color rubbed on thickly, leaving short stroke marks and the paper's tooth."}, "parser_surfaces_ja": null, "parser_surfaces_en": ["oil-pastel"], "default": false, "prompt": true, "display": true, "marker": null, "score_value": "oil_pastel", "marker_surfaces_ja": null, "marker_surfaces_en": null},
        {"id": "gouache", "surface_ja": "ガッシュ", "surface_en": "gouache", "physical_description": {"ja": "水で溶いた不透明な色が、つやの無い平らな塗りに乾き、筆の濃淡と擦れた副線が残る。", "en": "Opaque water-based color that dries to a flat, matte coat, with brush tonal variation and rubbed secondary lines."}, "default": false, "prompt": true, "display": true, "marker": null, "score_value": "gouache", "marker_surfaces_ja": null, "marker_surfaces_en": null},
        {"id": "watercolor", "surface_ja": "水彩", "surface_en": "watercolor", "physical_description": {"ja": "水で溶いた透ける色が紙にしみ、重なると濃くなり、縁に色が溜まる。", "en": "Transparent water-thinned color soaks into the paper, deepens where it overlaps, and pools at the edges."}, "parser_surfaces_ja": null, "parser_surfaces_en": ["watercolour"], "default": false, "prompt": true, "display": true, "marker": null, "score_value": "watercolor", "marker_surfaces_ja": null, "marker_surfaces_en": null},
        {"id": "oil_paint", "surface_ja": "油彩", "surface_en": "oil paint", "physical_description": {"ja": "油で練った絵具を厚く塗り重ね、刷毛筋と盛り上がり、つやのある重なりが残る。", "en": "Oil-bound paint laid on thickly, with bristle ridges, raised impasto, and glossy overlapping strokes."}, "default": false, "prompt": true, "display": true, "marker": null, "score_value": "oil_paint", "marker_surfaces_ja": null, "marker_surfaces_en": null},
        {"id": "painting_knife", "surface_ja": "ペインティングナイフ", "surface_en": "painting knife", "physical_description": {"ja": "ナイフで盛って伸ばした絵具の平らな面に、稜と縁、かすれが残る。", "en": "Paint heaped and spread with a knife into flat planes, leaving ridges, edges, and dry streaks."}, "parser_surfaces_ja": null, "parser_surfaces_en": ["painting-knife"], "default": false, "prompt": true, "display": true, "marker": null, "score_value": "painting_knife", "marker_surfaces_ja": null, "marker_surfaces_en": null},
        {"id": "etching", "surface_ja": "エッチング", "surface_en": "etching", "physical_description": {"ja": "酸で腐食させた太さのそろった線に、わずかな荒れと丸い端が残り、線の重ねで陰を作る。", "en": "Acid-bitten lines of even width with slightly rough edges and round ends; shading is built by layering lines."}, "default": false, "prompt": true, "display": true, "marker": null, "score_value": "etching", "marker_surfaces_ja": null, "marker_surfaces_en": null},
