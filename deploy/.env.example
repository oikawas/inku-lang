# inku deployment settings. Copy to `.env` next to compose.yaml and edit.
# Never commit the filled-in file: it holds API keys and the first password.

# ── Required ──────────────────────────────────────────────────────────────────

# Password for the administrator account created on the first startup of an
# empty database. Must be 8 characters or more. `docker compose up` refuses to
# start while this is blank, because inku has no self-service registration:
# without this account nobody can sign in. Change it from any example value
# before exposing the server, and sign in to create the accounts you need.
INKU_BOOTSTRAP_ADMIN_PASSWORD=

# LLM backend: `anthropic` (default) or `openai`. The `openai` path also serves
# OpenAI-compatible endpoints such as a local OpenVINO Model Server or, when a
# model id contains a slash, NVIDIA NIM.
INKU_LLM_BACKEND=anthropic

# Key for the backend selected above. Fill in only the one you use.
ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#NVIDIA_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────

# Administrator identity. Defaults are `admin` / `admin@localhost`.
#INKU_BOOTSTRAP_ADMIN_USERNAME=admin
#INKU_BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# Show developer-only model providers (currently NVIDIA NIM) and Build metadata.
# Leave disabled for ordinary installations.
#INKU_DEVELOPER_MODE=0

# Local Ollama, for running without an API key. Uncomment this line as written:
# inside the container `localhost` is the container itself, so the host has to be
# named. Ollama must also be started with a context length that holds a Stage 2
# prompt (OLLAMA_CONTEXT_LENGTH=16384 on the Ollama side). SETUP.md has the model
# pairing that was measured.
#OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# OpenAI-compatible endpoint and model ids, when INKU_LLM_BACKEND=openai.
#OPENAI_BASE_URL=http://127.0.0.1:18000/v3
#OPENAI_MODEL=
#OPENAI_MODEL_STAGE1=

# Released image tag. `latest` follows the newest release; pin a version such as
# `2.4.0` or `2.4` to hold a deployment steady.
#INKU_IMAGE_TAG=latest

# Published host ports. Defaults are 8100 (api) and 5173 (web).
#INKU_API_PORT=8100
#INKU_WEB_PORT=5173

# Public origin of the web UI. Must match the URL browsers actually use, or
# SvelteKit rejects form posts.
#INKU_ORIGIN=http://localhost:5173

# Set to 1 when serving over HTTPS, so session cookies carry the Secure flag.
#INKU_SESSION_COOKIE_SECURE=0

# Comma-separated browser origins allowed to call the API directly. Leave blank
# unless something other than the bundled web UI talks to the API.
#INKU_CORS_ORIGINS=
