  "stage_dependent": {
    "note": "Rule 3 reads the stage, so the same reference resolves differently per stage.",
    "stage_defaults": {
      "stage1_provider": "ollama",
      "stage2_provider": "anthropic"
    },
    "cases": [
      {
        "ref": "my-model",
        "stage1": "ollama",
        "stage2": "anthropic"
      },
      {
        "ref": "gpt-oss:20b",
        "stage1": "ollama",
        "stage2": "anthropic"
      },
      {
        "ref": "llama3.2",
        "stage1": "ollama",
        "stage2": "ollama",
        "why": "rule 2 wins before the stage is consulted"
      }
    ]
  },
  "ambiguity": {
    "note": "Rule 2 demands exactly one owner. Removing one owner makes it decide again.",
    "ref": "gpt-oss:20b",
    "owners": [
      "ollama",
      "ollama-cloud"
    ],
    "deactivate": "ollama",
    "provider_when_deactivated": "ollama-cloud"
  },
  "qualify": [
    {
      "provider": "ollama",
      "ref": "gemma4:31b",
      "expected": "ollama:gemma4:31b"
    },
    {
      "provider": "ollama",
      "ref": "ollama-cloud:gemma4:31b",
      "expected": "ollama-cloud:gemma4:31b",
      "why": "already qualified by a known provider; must not become ollama:ollama-cloud:..."
    },
    {
      "provider": "ollama",
      "ref": "ollama:gpt-oss:20b",
      "expected": "ollama:gpt-oss:20b"
    },
    {
      "provider": "ollama",
      "ref": "qwen3.5:4b-q4_K_M",
      "expected": "ollama:qwen3.5:4b-q4_K_M",
