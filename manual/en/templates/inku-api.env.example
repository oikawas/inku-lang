# inku-api environment example
# Copy to /etc/inku/inku-api.env, set owner/group to root:inku, and set mode to 0640.

INKU_SERVER_HOST=127.0.0.1
INKU_SERVER_PORT=8100
INKU_SERVER_RELOAD=0

# Database
INKU_DB_URL=sqlite:////var/lib/inku/inku.db

# Secret encryption for provider API keys stored in DB.
INKU_SECRET_KEY_FILE=/var/lib/inku/secret.key

# Initial admin. Used only when the DB has no users.
# The password is required: inku has no self-service registration, so this is
# the only way in. A blank value counts as unset, so after initial creation you
# may either blank the line or delete it.
INKU_BOOTSTRAP_ADMIN_USERNAME=admin
INKU_BOOTSTRAP_ADMIN_EMAIL=admin@example.local
INKU_BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# Sessions
INKU_SESSION_COOKIE_MAX_AGE=2592000
INKU_SESSION_COOKIE_SECURE=0

# Output artifacts. History DB remains the source of truth.
INKU_OUTPUT_DIR=/var/lib/inku/outputs
INKU_OUTPUT_PNG_SIZE=2160
INKU_OUTPUT_SAVE_WORKERS=2
INKU_OUTPUT_SAVE_QUEUE_LIMIT=32

# Pipeline concurrency
INKU_STAGE_WORKERS=4
INKU_STAGE_QUEUE_LIMIT=8

# Painting concurrency. These seed the first value only.
# After that the DB settings are canonical; change them from the admin UI
# or with inku-cli config update.
INKU_RENDER_CONCURRENCY=2
INKU_CLIENT_FANOUT_LIMIT=4

# Logs
INKU_LOG_RETENTION_DAYS=90
INKU_LOG_ROTATE=daily

# LLM retry and timeout
INKU_LLM_REQUEST_TIMEOUT_SECONDS=120
INKU_LLM_RETRY_ATTEMPTS=2
INKU_LLM_RETRY_BASE_DELAY=1
INKU_LLM_RETRY_MAX_DELAY=12
INKU_LLM_RETRY_JITTER=1

# Per-stage hard timeouts. They also apply to an execution slot that
# could not be acquired.
INKU_STAGE1_HARD_TIMEOUT_SECONDS=120
INKU_STAGE2_HARD_TIMEOUT_SECONDS=120
INKU_SKETCH_HARD_TIMEOUT_SECONDS=120

# Run mode and timezone
INKU_ENV=production
INKU_TIMEZONE=Asia/Tokyo

# Sign-in methods
INKU_AUTH_LOCAL_ENABLED=true
INKU_AUTH_GOOGLE_ENABLED=false

# Where declarative plugin documents live
INKU_DOCUMENT_PLUGIN_DIR=/var/lib/inku/plugins

# Where learned words are stored. The default is under /tmp and does not
# survive a restart.
INKU_LEARNED_FILE=/var/lib/inku/learned.json

# Set only when the backend runs in more than one process.
# INKU_REDIS_URL=redis://127.0.0.1:6379/0

# Provider keys. Set at least one, or configure providers from the admin UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OLLAMA_CLOUD_API_KEY=

# Optional provider base URLs
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
