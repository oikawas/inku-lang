{
	"name": "inku-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "node --import ./scripts/ts-extensionless-resolve.mjs --test \"src/**/*.test.ts\"",
		"lint:i18n": "node scripts/i18n-lint.mjs",
		"lint:models": "node scripts/model-ref-check.mjs",
		"lint:recommendations": "node scripts/model-recommendation-check.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"overrides": {
		"cookie": "0.7.2"
	}
}
