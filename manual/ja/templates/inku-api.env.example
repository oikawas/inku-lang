# inku-api 環境変数設定例
# /etc/inku/inku-api.env へコピーし、root:inku 所有、ファイル権限 0640 にしてください。

INKU_SERVER_HOST=127.0.0.1
INKU_SERVER_PORT=8100
INKU_SERVER_RELOAD=0

# DB
INKU_DB_URL=sqlite:////var/lib/inku/inku.db

# DB に保存する provider API key の暗号化鍵
INKU_SECRET_KEY_FILE=/var/lib/inku/secret.key

# 初期管理者。DB にユーザーが存在しない場合のみ使われます。
# password は必須です。inku にはセルフサインアップが無く、これが唯一の入口です。
# 空文字は未設定と同じ扱いなので、初回作成後は空欄にしても行を削除しても構いません。
INKU_BOOTSTRAP_ADMIN_USERNAME=admin
INKU_BOOTSTRAP_ADMIN_EMAIL=admin@example.local
INKU_BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# セッション
INKU_SESSION_COOKIE_MAX_AGE=2592000
INKU_SESSION_COOKIE_SECURE=0

# 出力 artifact。履歴 DB が正本です。
INKU_OUTPUT_DIR=/var/lib/inku/outputs
INKU_OUTPUT_PNG_SIZE=2160
INKU_OUTPUT_SAVE_WORKERS=2
INKU_OUTPUT_SAVE_QUEUE_LIMIT=32

# 任意の完全なpipeline manifest。作成手順はserver-configuration.md §2.4。
# 未指定時は組込既定。host_limitsはmax_workers=4 / max_effect_steps=32 /
# max_retained_runs=8。旧INKU_STAGE_WORKERS / INKU_STAGE_QUEUE_LIMITは使いません。
# INKU_PIPELINE_CONFIG=/etc/inku/pipeline.json

# 描画の並列度。これらは初回起動時の初期値だけを与えます。
# 以後の正本はDB設定。管理UIかapi PUT /api/settings/render-concurrencyで変更します。
INKU_RENDER_CONCURRENCY=2
INKU_CLIENT_FANOUT_LIMIT=4

# ログ
INKU_LOG_RETENTION_DAYS=90
INKU_LOG_ROTATE=daily

# 組込manifest用の有限retry policy。独自manifest指定時はJSON内を編集します。
# catalog選択・穴補完のattempt / total予算（秒）
INKU_LLM_REQUEST_TIMEOUT_SECONDS=120
# Stage 1のattempt / total予算（秒）
INKU_LLM_STAGE1_ATTEMPT_TIMEOUT_SECONDS=300
INKU_LLM_STAGE1_TOTAL_TIMEOUT_SECONDS=540
INKU_LLM_RETRY_ATTEMPTS=4
INKU_LLM_RETRY_BASE_DELAY=2

# 動作モードと timezone
INKU_ENV=production
INKU_TIMEZONE=Asia/Tokyo

# 認証方式
INKU_AUTH_LOCAL_ENABLED=true
INKU_AUTH_GOOGLE_ENABLED=false

# 宣言的プラグイン文書の置き場
INKU_DOCUMENT_PLUGIN_DIR=/var/lib/inku/plugins

# 学習語の保存先。既定は /tmp 配下なので再起動で消えます。
INKU_LEARNED_FILE=/var/lib/inku/learned.json

# backend を複数プロセスで動かす場合だけ設定します。
# INKU_REDIS_URL=redis://127.0.0.1:6379/0

# Provider key。少なくとも 1 つを設定するか、管理 UI から provider を設定します。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OLLAMA_CLOUD_API_KEY=

# 任意の provider Base URL
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
