[Unit]
Description=inku FastAPI rendering API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inku
Group=inku
WorkingDirectory=/opt/inku/inku-lang/server
EnvironmentFile=/etc/inku/inku-api.env
Environment=UV_CACHE_DIR=/tmp/inku-uv-cache
ExecStart=/usr/local/bin/uv run inku-server
Restart=on-failure
RestartSec=5
# Logging: the application writes and rotates its own file under INKU_LOG_DIR,
# and these lines also go to the journal. Do not add StandardOutput=journal+append:
# -- systemd cannot parse that specifier and ignores the whole line.

[Install]
WantedBy=multi-user.target
