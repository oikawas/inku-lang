[Unit]
Description=inku FastAPI rendering API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inku
Group=inku
WorkingDirectory=/opt/inku/inku-lang/server
EnvironmentFile=/etc/inku/inku-api.env
Environment=UV_CACHE_DIR=/tmp/inku-uv-cache
ExecStart=/usr/local/bin/uv run inku-server
Restart=on-failure
RestartSec=5
LogsDirectory=inku
StandardOutput=journal+append:/var/log/inku/inku-api.log
StandardError=journal+append:/var/log/inku/inku-api.log

[Install]
WantedBy=multi-user.target
