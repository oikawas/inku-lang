      "pipeline": "3本の線を引く",
      "spans": [],
      "source_labels": []
    },
    {
      "why": "a half-width space alone does not make a digit a label",
      "text": "3 本の線を引く",
      "pipeline": "3 本の線を引く",
      "spans": [],
      "source_labels": []
    },
    {
      "why": "a bracketed source is a comment",
