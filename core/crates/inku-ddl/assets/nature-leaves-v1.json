              {"op": "vary", "binding": "root_x", "domain": "karekusa_bottom_spot", "choices": [{"expr": "exact_decimal", "value": "0.28"}, {"expr": "exact_decimal", "value": "0.72"}], "range": null, "body": [
                {"op": "vary", "binding": "blade_count", "domain": "karekusa_blade_count", "choices": [{"expr": "integer", "value": 3}, {"expr": "integer", "value": 4}, {"expr": "integer", "value": 5}], "range": null, "body": [
                  {"op": "repeat", "count": {"expr": "local", "name": "blade_count"}, "maximum": 5, "index": "blade_index", "body": [
                    {"op": "vary", "binding": "blade_chord", "domain": "karekusa_blade_height", "choices": [{"expr": "exact_decimal", "value": "0.18"}, {"expr": "exact_decimal", "value": "0.24"}, {"expr": "exact_decimal", "value": "0.30"}], "range": null, "body": [
                      {"op": "vary", "binding": "blade_lean", "domain": "karekusa_blade_lean", "choices": [
                        {"expr": "semantic_ref", "category": "angle", "id": "vertical"},
                        {"expr": "semantic_ref", "category": "angle", "id": "diagonal"},
                        {"expr": "semantic_ref", "category": "angle", "id": "falling"}
                      ], "range": null, "body": [
                        {"op": "use", "component": "rooted_blade", "arguments": {
                          "chord": {"expr": "local", "name": "blade_chord"},
                          "lean": {"expr": "local", "name": "blade_lean"},
                          "x": {"expr": "local", "name": "root_x"},
                          "y": {"expr": "exact_decimal", "value": "0.90"}
                        }}
                      ]}
                    ]}
                  ]}
                ]}
              ]}
            ]}
          ]}
        ]
