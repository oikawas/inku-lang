# inku-server environment variables
# Copy to .env and fill in values. .env is gitignored.

# Show developer-only model providers (currently NVIDIA NIM) and Build metadata.
INKU_DEVELOPER_MODE=1

# Optional ChatGPT plan. Source local startup uses inku-chatgpt serve.
# Set SELF_HOSTED too for inku-server verified self-hosted startup with account
# sign-in and developer mode off; container Compose persists auth at /data/chatgpt.
#INKU_CHATGPT_PLAN_ENABLED=0
#INKU_CHATGPT_SELF_HOSTED=0
# Only a fixed helper destination is supported; omit for the source helper.
#INKU_CHATGPT_HELPER_TARGET=container

ANTHROPIC_API_KEY=sk-ant-...
