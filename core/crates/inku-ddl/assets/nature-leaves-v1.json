                "shape": {"expr": "semantic_ref", "category": "shape", "id": "arc"},
                "touch": {"expr": "semantic_ref", "category": "touch", "id": "chalk"}
              }},
              {"op": "emit", "binding": "edge_b", "fields": {
                "chord": {"expr": "parameter", "name": "chord"},
                "color": {"expr": "semantic_ref", "category": "color", "id": "gray"},
                "fluctuation_frequency": {"expr": "semantic_ref", "category": "variation", "id": "quickly"},
                "fluctuation_quality": {"expr": "semantic_ref", "category": "variation", "id": "blurring"},
                "movement": {"expr": "semantic_ref", "category": "movement", "id": "place"},
                "sagitta": {"expr": "exact_decimal", "value": "0.014"},
                "shape": {"expr": "semantic_ref", "category": "shape", "id": "arc"},
                "touch": {"expr": "semantic_ref", "category": "touch", "id": "chalk"}
              }},
              {"op": "relation", "kind": "connected", "from": "root", "to": "edge_a"},
              {"op": "relation", "kind": "touching", "from": "edge_a", "to": "edge_b"}
            ]
          }
        },
        "body": [
          {"op": "vary", "binding": "root_count", "domain": "karekusa_root_count", "choices": [{"expr": "integer", "value": 1}, {"expr": "integer", "value": 2}], "range": null, "body": [
