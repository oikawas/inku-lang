{
  "note": "Read by server/tests/test_description_labels.py and by web/src/lib/description-labels.test.ts. The rule lives in two languages because the editor has to paint exactly what the server drops; this file is what keeps them the same rule.",
  "cases": [
    {
      "why": "a plain description is untouched",
      "text": "花の色はうつりにけりないたづらに",
      "pipeline": "花の色はうつりにけりないたづらに",
      "spans": [],
      "source_labels": []
    },
    {
      "why": "half-width number and full stop",
      "text": "1. 花の色はうつりにけりな",
      "pipeline": "花の色はうつりにけりな",
      "spans": [
        [
          0,
          3,
          "number"
        ]
      ],
      "source_labels": []
    },
    {
      "why": "a leading zero is still a number",
      "text": "01. 花の色",
      "pipeline": "花の色",
      "spans": [
        [
          0,
          4,
          "number"
        ]
      ],
      "source_labels": []
    },
    {
      "why": "full-width digits and a full-width stop",
      "text": "０１．花の色",
      "pipeline": "花の色",
      "spans": [
        [
          0,
          3,
          "number"
        ]
      ],
      "source_labels": []
    },
    {
      "why": "an ideographic space is how a numbered line is written in Japanese",
      "text": "１　花の色",
      "pipeline": "花の色",
      "spans": [
        [
          0,
          2,
          "number"
        ]
      ],
      "source_labels": []
    },
    {
      "why": "a closing parenthesis is a numbering too",
      "text": "12） 花の色",
      "pipeline": "花の色",
      "spans": [
        [
          0,
          4,
          "number"
        ]
      ],
      "source_labels": []
    },
    {
      "why": "a colon as well",
      "text": "3: 花の色",
      "pipeline": "花の色",
      "spans": [
        [
          0,
          3,
          "number"
        ]
      ],
      "source_labels": []
    },
    {
      "why": "a year is description, not a number label",
