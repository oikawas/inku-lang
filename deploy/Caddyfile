{
	skip_install_trust
	auto_https disable_redirects
	default_sni {$INKU_PUBLIC_HOST}
	http_port {$INKU_HTTP_PORT:80}
	https_port {$INKU_HTTPS_PORT:443}
	servers {
		protocols h1 h2
	}
}

https://{$INKU_PUBLIC_HOST}:{$INKU_HTTPS_PORT:443} {
	reverse_proxy web:5173
}

http://{$INKU_PUBLIC_HOST}:{$INKU_HTTP_PORT:80} {
	# Offer the root only at this path and only for supported local names.
	# A volume reused after switching to a public domain can still contain it.
	@local_ca {
		path /ca.crt
		expression `{http.request.host}.matches(r'(?i)^(localhost|.+\.(localhost|local|internal|home\.arpa)|(10|127)(\.[0-9]{1,3}){3}|(192\.168|172\.(1[6-9]|2[0-9]|3[01]))(\.[0-9]{1,3}){2})$')`
	}
	handle @local_ca {
		rewrite * /root.crt
		file_server {
			root /data/caddy/pki/authorities/local
		}
	}
	handle /ca.crt {
		respond 404
	}
	handle {
		redir https://{$INKU_PUBLIC_HOST}:{$INKU_HTTPS_PORT:443}{uri} permanent
	}
}
