{
  "schema": "inku.normalized-ddl-document-v1-fixture.v1",
  "version": 1,
  "valid_cases": [
    {
      "id": "ja-source-preserves-crlf-and-macro-term",
      "source": "背景を白で埋める。\r\n  Nature.青葉を八つ、枝に沿って右上へ散らす。\r\n",
      "language": "ja",
      "locks": [
        {
          "qualified_name": "nature.青 葉.春",
          "version": "1.0.0",
          "digest": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        },
        {
          "qualified_name": "alpha.pond",
          "version": "2.1.0-beta.1",
          "digest": "sha256:abcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcd"
        }
      ],
      "expected": {
        "source": "背景を白で埋める。\r\n  Nature.青葉を八つ、枝に沿って右上へ散らす。\r\n",
        "language": "ja",
        "locks": [
          {
            "qualified_name": "alpha.pond",
            "version": "2.1.0-beta.1",
            "digest": "sha256:abcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcd"
          },
          {
            "qualified_name": "nature.青 葉.春",
            "version": "1.0.0",
            "digest": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
          }
        ]
      }
    },
    {
      "id": "en-source-preserves-whitespace-and-macro-term",
      "source": "  Fill the background with white.\nNature.aoba forms stay visible semantic text.  \n",
      "language": "en",
      "locks": [],
      "expected": {
        "source": "  Fill the background with white.\nNature.aoba forms stay visible semantic text.  \n",
        "language": "en",
        "locks": []
      }
    },
    {
      "id": "blank-source-is-semantic-parser-work",
      "source": " \t\r\n",
      "language": "ja",
      "locks": [],
      "expected": {
        "source": " \t\r\n",
        "language": "ja",
        "locks": []
      }
    }
  ],
  "invalid_macro_lock_cases": [
    {
      "id": "lock-qualified-name-malformed",
      "lock": {
        "qualified_name": "missing-dot",
        "version": "1.0.0",
        "digest": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
      },
      "expected_code": "invalid_qualified_name"
    },
    {
      "id": "semantic-version-invalid",
      "lock": {
        "qualified_name": "nature.aoba",
        "version": "01.0.0",
        "digest": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
      },
      "expected_code": "invalid_semantic_version"
    },
    {
      "id": "digest-short",
      "lock": {
        "qualified_name": "nature.aoba",
        "version": "1.0.0",
        "digest": "sha256:0123"
      },
      "expected_code": "invalid_digest"
    },
    {
      "id": "digest-uppercase",
      "lock": {
        "qualified_name": "nature.aoba",
        "version": "1.0.0",
        "digest": "sha256:ABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCD"
      },
      "expected_code": "invalid_digest"
    },
    {
      "id": "lock-qualified-name-leading-space",
      "lock": {
        "qualified_name": "nature. aoba",
        "version": "1.0.0",
        "digest": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
      },
      "expected_code": "invalid_qualified_name"
    }
  ],
  "duplicate_lock_cases": [
    {
      "id": "lock-identical-duplicate",
      "source": "Nature.aobaを置く。",
      "language": "ja",
      "locks": [
        {
          "qualified_name": "nature.aoba",
          "version": "1.0.0",
          "digest": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        },
        {
          "qualified_name": "nature.aoba",
          "version": "1.0.0",
          "digest": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        }
      ],
      "expected_code": "duplicate_macro_lock"
    },
    {
      "id": "lock-conflicting-duplicate",
      "source": "Nature.aobaを置く。",
      "language": "ja",
      "locks": [
        {
          "qualified_name": "nature.aoba",
          "version": "1.0.0",
          "digest": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        },
        {
          "qualified_name": "nature.aoba",
          "version": "1.0.1",
          "digest": "sha256:abcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcd"
        }
      ],
      "expected_code": "conflicting_macro_lock"
    }
  ]
}
